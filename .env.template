# Chroma MCP Server - Environment Configuration Template
# Copy this file to .env and modify the values for your environment

# Ollama Server Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text

# Alternative configurations:
# For Docker Compose: OLLAMA_URL=http://ollama:11434
# For remote server: OLLAMA_URL=http://your-server-ip:11434
# For custom port: OLLAMA_URL=http://localhost:8080

# Popular embedding models:
# OLLAMA_MODEL=nomic-embed-text      # General purpose, good performance
# OLLAMA_MODEL=mxbai-embed-large     # Higher accuracy, slower
# OLLAMA_MODEL=all-minilm            # Lightweight and fast

# ChromaDB Configuration (optional)
# CHROMA_CLIENT_TYPE=persistent
# CHROMA_DATA_DIR=/path/to/chroma/data

# API Keys for cloud embedding functions (if using)
# CHROMA_OPENAI_API_KEY=your_openai_key
# CHROMA_COHERE_API_KEY=your_cohere_key
# CHROMA_JINA_API_KEY=your_jina_key
